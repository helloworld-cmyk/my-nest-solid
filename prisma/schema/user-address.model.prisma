model UserAddress {
  id        String  @id @default(uuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String 
  phone     String
  email     String?
  address   String @db.Text 
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  orders Order[] 
}