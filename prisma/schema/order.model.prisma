enum OrderStatus {
  PENDING_PAYMENT 
  CONFIRMED       
  PROCESSING      
  SHIPPED         
  DELIVERED       
  CANCELLED      
  REFUNDED        
}

enum PaymentMethod {
  COD
  CARD 
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id     String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict) 

  status         OrderStatus   @default(PENDING_PAYMENT)

  paymentMethod  PaymentMethod @default(COD)
  paymentStatus  PaymentStatus @default(PENDING)

  paymentCardId  String? 
  paymentCardLast4 String? 
  paymentCardBrand String?

  addressId       String?
  address         UserAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  addressSnapshot Json 

  subtotal   Decimal @db.Decimal(12, 2) 
  discount   Decimal @default(0) @db.Decimal(12, 2) 
  shippingFee Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2) 

  couponId  String? 
  couponCode String? 

  idempotencyKey String @unique //block duplicate order
  note    String? @db.Text 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade) 

  productId Int? 
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  variantSku  String? // snapshot sku
  name        String // tên lúc mua
  imagePath   String // ảnh lúc mua (isAsset để app biết fallback)
  colorHexCode Int?   // snapshot màu đã chọn
  size        String? // snapshot size đã chọn
  unitPrice   Decimal @db.Decimal(12, 2) // ĐƠN GIÁ chốt lúc đặt
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2) // unitPrice * quantity — lưu sẵn để load list không phải nhân

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}